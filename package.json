{
  "name": "@osqd/ui",
  "version": "0.7.1",
  "description": "Utilitarian UI kit for the OSQD projects: a dark theme and a light one, plain CSS components that work in any page, and React components on top.",
  "keywords": [
    "ui",
    "components",
    "react",
    "css",
    "theme",
    "design-system"
  ],
  "author": "Michał Płatosz <platosz.michal@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSQD-ts/OSQD-UI.git"
  },
  "homepage": "https://github.com/OSQD-ts/OSQD-UI#readme",
  "bugs": {
    "url": "https://github.com/OSQD-ts/OSQD-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css",
    "./dist/elements-auto.*",
    "./assets/osqd-ui-elements.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements.js",
      "require": "./dist/elements.cjs"
    },
    "./elements/auto": {
      "types": "./dist/elements/auto.d.ts",
      "import": "./dist/elements-auto.js",
      "require": "./dist/elements-auto.cjs"
    },
    "./css": "./dist/osqd-ui.css",
    "./styles/*": "./styles/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles",
    "assets/icons",
    "assets/icons.svg",
    "assets/icons.json",
    "assets/illustrations",
    "assets/osqd-ui-elements.js",
    "assets/fonts/subsets",
    "assets/fonts/OFL.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "icons": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check",
    "elements": "node scripts/elements.mjs",
    "elements:check": "node scripts/elements.mjs --check",
    "css": "node scripts/build-css.mjs",
    "docs": "node scripts/docs.mjs",
    "docs:check": "tsc --noEmit --strict --exactOptionalPropertyTypes --noUncheckedIndexedAccess --module esnext --moduleResolution bundler --target es2022 --jsx react-jsx --lib es2022,dom,dom.iterable --skipLibCheck --types react,react-dom scripts/docs-examples.tsx && node scripts/docs.mjs --check",
    "build": "npm run tokens && npm run fonts && npm run icons && npm run elements && tsup && tsc -p tsconfig.json --emitDeclarationOnly && npm run css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "check": "npm run tokens:check && npm run fonts:check && npm run icons:check && npm run elements:check && npm run docs:check && npm run samples:check && npm run typecheck && npm run typecheck:types && npm run lint && npm test",
    "preview": "python3 -m http.server 11240",
    "typecheck:types": "tsc --noEmit --strict --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 --skipLibCheck --exactOptionalPropertyTypes --noUncheckedIndexedAccess tests/types/*.tsx",
    "samples": "node examples/build.mjs",
    "samples:check": "node examples/build.mjs --check",
    "audit:mobile": "node scripts/responsive-audit.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "fonts": "node type/build.mjs",
    "fonts:check": "node type/build.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4",
    "opentype.js": "^2.0.0",
    "pathkit-wasm": "^1.0.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wawoff2": "^2.0.1"
  }
}
